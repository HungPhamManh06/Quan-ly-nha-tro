@model Invoice
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    var daTT = Model.TrangThaiThanhToan == InvoicePaymentStatus.DaThanhToan;
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Quản lý hóa đơn</a>

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <div class="brand-icon" style="width:52px;height:52px;border-radius:14px;font-size:1.3rem"><i class="bi bi-receipt"></i></div>
        <div>
            <h1 class="page-title mb-0">@Model.MaHoaDonKyHieu</h1>
            <div class="mt-1">
                <span class="badge @(daTT ? "badge-dathanhtoan" : "badge-chuathanhtoan")">@Model.TrangThaiThanhToan.GetDisplayName()</span>
                <span class="mini-tag ms-1">@Model.Room?.MaPhongKyHieu</span>
                <span class="mini-tag ms-1">Kỳ @Model.KyHoaDon</span>
            </div>
        </div>
    </div>
    <div class="page-actions">
        @if (!daTT)
        {
            <a asp-controller="Payments" asp-action="Pay" asp-route-id="@Model.MaHoaDon" class="btn btn-success"><i class="bi bi-cash-coin me-1"></i>Thanh toán</a>
        }
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-list me-1"></i>Danh sách</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">Chi tiết hóa đơn</div>
            <div class="card-body">
                <dl class="mb-3">
                    <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Phòng</dt><dd><a asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.MaPhong">@Model.Room?.MaPhongKyHieu · @Model.Room?.TenPhong</a></dd></div>
                    <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Ngày lập</dt><dd class="num">@Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</dd></div>
                    <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Hạn thanh toán</dt><dd class="num">@(Model.HanThanhToan?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
                    <div class="d-flex justify-content-between py-1"><dt class="text-muted fw-normal small">Ghi chú</dt><dd class="text-end">@(Model.GhiChu ?? "—")</dd></div>
                </dl>

                <table class="table table-sm">
                    <thead><tr><th>Khoản mục</th><th class="text-end">Thành tiền</th></tr></thead>
                    <tbody>
                        <tr><td>Tiền phòng</td><td class="text-end money">@Model.TienPhong.ToString("N0") đ</td></tr>
                        <tr><td>Tiền điện</td><td class="text-end money">@Model.TienDien.ToString("N0") đ</td></tr>
                        <tr><td>Tiền nước</td><td class="text-end money">@Model.TienNuoc.ToString("N0") đ</td></tr>
                        <tr><td>Tiền dịch vụ</td><td class="text-end money">@Model.TienDichVu.ToString("N0") đ</td></tr>
                    </tbody>
                    <tfoot>
                        <tr style="background:var(--color-primary-soft)">
                            <td class="fw-bold">Tổng tiền</td>
                            <td class="text-end money fw-bold text-primary fs-5">@Model.TongTien.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-cash-coin me-2 text-success"></i>Thanh toán</div>
            <div class="card-body">
                @if (Model.Payment != null)
                {
                    <dl class="mb-0">
                        <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Số tiền</dt><dd class="money fw-semibold text-success">@Model.Payment.SoTien.ToString("N0") đ</dd></div>
                        <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Ngày thanh toán</dt><dd class="num">@Model.Payment.NgayThanhToan.ToString("dd/MM/yyyy HH:mm")</dd></div>
                        <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Phương thức</dt><dd>@Model.Payment.PhuongThuc.GetDisplayName()</dd></div>
                        <div class="d-flex justify-content-between py-1"><dt class="text-muted fw-normal small">Ghi chú</dt><dd class="text-end">@(Model.Payment.GhiChu ?? "—")</dd></div>
                    </dl>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 td-muted">
                        <i class="bi bi-clock-history"></i>
                        <span>Hóa đơn chưa được thanh toán.</span>
                    </div>
                    @if (!daTT)
                    {
                        <a asp-controller="Payments" asp-action="Pay" asp-route-id="@Model.MaHoaDon" class="btn btn-success btn-sm mt-2"><i class="bi bi-cash-coin me-1"></i>Ghi nhận thanh toán</a>
                    }
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-person me-2"></i>Người thuê theo hợp đồng</div>
            <div class="card-body">
                @if (Model.Contract?.Tenant != null)
                {
                    <div class="fw-semibold">@Model.Contract.Tenant.HoTen</div>
                    <div class="small td-muted">CCCD: @Model.Contract.Tenant.CCCD · Hợp đồng @Model.Contract.MaHopDongKyHieu</div>
                }
                else
                {
                    <div class="td-muted">Không gắn với hợp đồng cụ thể.</div>
                }
            </div>
        </div>
    </div>
</div>
