@model List<Invoice>
@{
    ViewData["Title"] = "Quản lý hóa đơn";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý hóa đơn</h1>
        <p class="page-subtitle">Hóa đơn theo kỳ — mỗi phòng chỉ một hóa đơn mỗi kỳ</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Lập hóa đơn</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body toolbar py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4 col-lg-4">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:#94A3B8"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="padding-left:34px" placeholder="Tìm theo mã hóa đơn / phòng…" />
                </div>
            </div>
            <div class="col-md-3 col-lg-2">
                <select name="ky" class="form-select" asp-items="ViewBag.KyList">
                    <option value="">Tất cả kỳ</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <select name="trangThai" class="form-select" asp-items="Html.GetEnumSelectList<InvoicePaymentStatus>()">
                    <option value="">Tất cả trạng thái</option>
                </select>
            </div>
            <div class="col-md-2 col-lg-2">
                <button class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Lọc</button>
            </div>
            <div class="col-md-2 col-lg-2">
                <a asp-action="Index" class="btn btn-secondary w-100">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-receipt"></i></div>
            <div class="empty-title">Chưa có hóa đơn nào</div>
            <p class="empty-desc">Lập hóa đơn đầu tiên từ dữ liệu điện nước và dịch vụ đã ghi.</p>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Lập hóa đơn</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Phòng</th>
                        <th class="d-none d-md-table-cell">Kỳ</th>
                        <th class="d-none d-lg-table-cell text-end">Tiền phòng</th>
                        <th class="d-none d-lg-table-cell text-end">Điện</th>
                        <th class="d-none d-lg-table-cell text-end">Nước</th>
                        <th class="d-none d-lg-table-cell text-end">DV</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        var daTT = inv.TrangThaiThanhToan == InvoicePaymentStatus.DaThanhToan;
                        <tr>
                            <td class="cell-code">@inv.MaHoaDonKyHieu</td>
                            <td><a asp-controller="Rooms" asp-action="Details" asp-route-id="@inv.MaPhong" class="fw-semibold">@inv.Room?.MaPhongKyHieu</a></td>
                            <td class="d-none d-md-table-cell td-muted">@inv.KyHoaDon</td>
                            <td class="d-none d-lg-table-cell text-end money td-muted">@inv.TienPhong.ToString("N0")</td>
                            <td class="d-none d-lg-table-cell text-end money td-muted">@inv.TienDien.ToString("N0")</td>
                            <td class="d-none d-lg-table-cell text-end money td-muted">@inv.TienNuoc.ToString("N0")</td>
                            <td class="d-none d-lg-table-cell text-end money td-muted">@inv.TienDichVu.ToString("N0")</td>
                            <td class="text-end money fw-bold">@inv.TongTien.ToString("N0") đ</td>
                            <td><span class="badge @(daTT ? "badge-dathanhtoan" : "badge-chuathanhtoan")">@inv.TrangThaiThanhToan.GetDisplayName()</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-1">
                                    @if (!daTT)
                                    {
                                        <a asp-controller="Payments" asp-action="Pay" asp-route-id="@inv.MaHoaDon" class="btn btn-success btn-sm-icon" title="Thanh toán"><i class="bi bi-cash-coin"></i></a>
                                    }
                                    <div class="dropdown">
                                        <button class="btn-dots" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Thao tác"><i class="bi bi-three-dots-vertical"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@inv.MaHoaDon"><i class="bi bi-eye"></i>Xem chi tiết</a></li>
                                            @if (!daTT)
                                            {
                                                <li><a class="dropdown-item" asp-controller="Payments" asp-action="Pay" asp-route-id="@inv.MaHoaDon"><i class="bi bi-cash-coin"></i>Thanh toán</a></li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
