@model InvoiceCreateViewModel
@{
    ViewData["Title"] = "Lập hóa đơn";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Quản lý hóa đơn</a>

<div class="page-header">
    <div>
        <h1 class="page-title">Lập hóa đơn</h1>
        <p class="page-subtitle">Tự động lấy tiền phòng, điện, nước và dịch vụ theo kỳ</p>
    </div>
</div>

<div class="card" style="max-width:960px">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <h6 class="section-title"><i class="bi bi-calendar-month text-primary"></i>Phòng &amp; kỳ hóa đơn</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-5">
                    <label asp-for="MaPhong" class="form-label"></label>
                    <select asp-for="MaPhong" class="form-select" asp-items="new SelectList(Model.Rooms, nameof(Room.MaPhong), nameof(Room.TenPhong))" id="roomSelect">
                        <option value="">-- Chọn phòng --</option>
                    </select>
                    <span asp-validation-for="MaPhong" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="KyHoaDon" class="form-label"></label>
                    <input asp-for="KyHoaDon" class="form-control" type="month" />
                    <span asp-validation-for="KyHoaDon" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HanThanhToan" class="form-label"></label>
                    <input asp-for="HanThanhToan" class="form-control" type="date" />
                </div>
            </div>

            @if (Model.MaPhong > 0)
            {
                @if (Model.TienPhong == 0 && Model.TienDien == 0 && Model.TienNuoc == 0 && Model.TienDichVu == 0)
                {
                    <div class="alert alert-warning small d-flex gap-2 align-items-start">
                        <i class="bi bi-exclamation-triangle mt-1"></i>
                        <div>Phòng @Model.TenPhong chưa có dữ liệu điện nước / dịch vụ cho kỳ này và không xác định được hợp đồng để lấy tiền phòng. Hãy kiểm tra lại.</div>
                    </div>
                }
                else
                {
                    <div class="alert alert-light border small d-flex flex-column gap-1 mb-4">
                        @if (!string.IsNullOrEmpty(Model.ChiTietDienNuoc))
                        {
                            <div><i class="bi bi-lightning-charge text-warning me-1"></i>@Model.ChiTietDienNuoc</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.ChiTietDichVu))
                        {
                            <div><i class="bi bi-wifi text-info me-1"></i>@Model.ChiTietDichVu</div>
                        }
                    </div>
                }
            }

            <h6 class="section-title"><i class="bi bi-calculator text-primary"></i>Các khoản tiền</h6>
            <div class="row g-3 mb-1">
                <div class="col-md-3">
                    <label asp-for="TienPhong" class="form-label"></label>
                    <input asp-for="TienPhong" class="form-control" type="number" min="0" />
                </div>
                <div class="col-md-3">
                    <label asp-for="TienDien" class="form-label"></label>
                    <input asp-for="TienDien" class="form-control" type="number" min="0" />
                </div>
                <div class="col-md-3">
                    <label asp-for="TienNuoc" class="form-label"></label>
                    <input asp-for="TienNuoc" class="form-control" type="number" min="0" />
                </div>
                <div class="col-md-3">
                    <label asp-for="TienDichVu" class="form-label"></label>
                    <input asp-for="TienDichVu" class="form-control" type="number" min="0" />
                </div>
                <div class="col-md-6">
                    <div class="border rounded-3 p-3" style="border-color:var(--color-border) !important;background:var(--color-primary-soft)">
                        <div class="kpi-label">Tổng tiền (tự động)</div>
                        <div class="fs-4 fw-bold text-primary money" id="tongTienPreview">@Model.TongTien.ToString("N0") đ</div>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label"></label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="alert alert-info small d-flex gap-2 align-items-start mt-3 mb-4">
                <i class="bi bi-info-circle mt-1"></i>
                <div>Mỗi phòng chỉ có một hóa đơn cho một kỳ. Tổng tiền = Tiền phòng + Điện + Nước + Dịch vụ (tính lại phía server).</div>
            </div>

            <div class="d-flex gap-2 pt-3 border-top">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lập hóa đơn</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function recalc() {
            const tp = parseFloat(document.getElementById('TienPhong')?.value || 0);
            const td = parseFloat(document.getElementById('TienDien')?.value || 0);
            const tn = parseFloat(document.getElementById('TienNuoc')?.value || 0);
            const tv = parseFloat(document.getElementById('TienDichVu')?.value || 0);
            const el = document.getElementById('tongTienPreview');
            if (el) el.textContent = new Intl.NumberFormat('vi-VN').format(tp + td + tn + tv) + ' đ';
        }
        ['TienPhong', 'TienDien', 'TienNuoc', 'TienDichVu'].forEach(function (id) {
            document.getElementById(id)?.addEventListener('input', recalc);
        });
        document.getElementById('roomSelect')?.addEventListener('change', function () {
            const ky = document.getElementById('KyHoaDon')?.value;
            window.location = '@Url.Action("Create", "Invoices")' + '?roomId=' + this.value + '&ky=' + (ky || '');
        });
        document.getElementById('KyHoaDon')?.addEventListener('change', function () {
            const room = document.getElementById('roomSelect')?.value;
            window.location = '@Url.Action("Create", "Invoices")' + '?roomId=' + (room || '') + '&ky=' + this.value;
        });
    </script>
}
