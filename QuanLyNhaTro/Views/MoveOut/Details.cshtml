@model MoveOut
@{
    ViewData["Title"] = "Kết quả trả phòng";
}

<h3 class="fw-bold mb-4"><i class="bi bi-check2-circle me-2 text-success"></i>Kết quả quyết toán trả phòng</h3>

<div class="card chart-card mb-3" style="max-width:760px">
    <div class="card-header bg-transparent fw-semibold">Hợp đồng @Model.Contract?.MaHopDongKyHieu - phòng @Model.Contract?.Room?.MaPhongKyHieu</div>
    <div class="card-body">
        <table class="table table-bordered mb-3">
            <tbody>
                <tr><td class="w-50">Ngày trả phòng</td><td class="text-end">@Model.NgayTraPhong.ToString("dd/MM/yyyy")</td></tr>
                <tr><td>Công nợ trước trả phòng</td><td class="text-end">@Model.CongNoTruocTraPhong.ToString("N0") đ</td></tr>
                <tr><td>Tiền phát sinh cuối kỳ</td><td class="text-end">@Model.TienPhatSinhCuoiKy.ToString("N0") đ</td></tr>
                <tr class="table-warning fw-semibold"><td>Khoản phải thu cuối cùng</td><td class="text-end">@Model.KhoanPhaiThuCuoiCung.ToString("N0") đ</td></tr>
                <tr><td>Tiền cọc ban đầu</td><td class="text-end">@Model.TienCocBanDau.ToString("N0") đ</td></tr>
                <tr><td>Tiền khấu trừ cọc</td><td class="text-end">@Model.TienKhauTruCoc.ToString("N0") đ</td></tr>
                <tr class="table-success fw-semibold"><td>Tiền hoàn cọc</td><td class="text-end">@Model.TienHoanCoc.ToString("N0") đ</td></tr>
                <tr class="table-danger fw-semibold"><td>Tiền phải trả thêm</td><td class="text-end">@Model.TienPhaiTraThem.ToString("N0") đ</td></tr>
                <tr><td>Trạng thái phòng sau trả</td><td class="text-end">@Model.TrangThaiPhongSauTra.GetDisplayName()</td></tr>
                <tr><td>Ghi chú</td><td class="text-end">@(Model.GhiChu ?? "-")</td></tr>
            </tbody>
        </table>
        <div class="alert alert-success mb-0">
            <i class="bi bi-check-circle me-1"></i>
            Hợp đồng đã thanh lý, phòng đã chuyển sang trạng thái <b>@Model.TrangThaiPhongSauTra.GetDisplayName()</b>.
        </div>
    </div>
</div>

<div>
    <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.MaHopDong" class="btn btn-outline-primary"><i class="bi bi-file-earmark-text me-1"></i>Xem hợp đồng</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Danh sách trả phòng</a>
</div>
