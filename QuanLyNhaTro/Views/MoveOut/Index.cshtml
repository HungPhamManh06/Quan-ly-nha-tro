@model List<Contract>
@{
    ViewData["Title"] = "Trả phòng";
    var today = DateTime.Today;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Trả phòng · Quyết toán</h1>
        <p class="page-subtitle">Chọn hợp đồng còn hiệu lực để bắt đầu quy trình quyết toán trả phòng</p>
    </div>
</div>

<div class="alert alert-light border small d-flex gap-2 align-items-start" style="max-width:960px">
    <i class="bi bi-info-circle mt-1"></i>
    <div>
        Quy trình: chốt điện nước → chốt dịch vụ → kiểm tra công nợ → tính cọc → quyết toán → thanh lý hợp đồng → cập nhật phòng.
        Mỗi hợp đồng chỉ được quyết toán <b>một lần duy nhất</b>.
    </div>
</div>

<div class="card" style="max-width:1100px">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon" style="background:var(--color-success-soft);color:var(--color-success)"><i class="bi bi-check2-circle"></i></div>
            <div class="empty-title">Không có hợp đồng nào có thể trả phòng</div>
            <p class="empty-desc">Tất cả hợp đồng đang hiệu lực đã được quyết toán hoặc không tồn tại.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Phòng</th>
                        <th class="d-none d-md-table-cell">Người thuê</th>
                        <th class="d-none d-lg-table-cell">Thời hạn</th>
                        <th class="text-end">Giá thuê</th>
                        <th class="text-end">Tiền cọc</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="cell-code">@c.MaHopDongKyHieu</td>
                            <td><a asp-controller="Rooms" asp-action="Details" asp-route-id="@c.MaPhong" class="fw-semibold">@c.Room?.MaPhongKyHieu</a></td>
                            <td class="d-none d-md-table-cell">@c.Tenant?.HoTen</td>
                            <td class="d-none d-lg-table-cell small num">@c.NgayBatDau.ToString("dd/MM/yy") → @c.NgayKetThuc.ToString("dd/MM/yy")</td>
                            <td class="text-end money">@c.GiaThue.ToString("N0") đ</td>
                            <td class="text-end money fw-semibold text-primary">@c.TienCoc.ToString("N0") đ</td>
                            <td class="text-end">
                                <a asp-action="Settle" asp-route-id="@c.MaHopDong" class="btn btn-danger btn-sm">
                                    <i class="bi bi-box-arrow-right me-1"></i>Quyết toán
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
