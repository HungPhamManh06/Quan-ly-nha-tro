@model MoveOutViewModel
@{
    ViewData["Title"] = "Quyết toán trả phòng";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="fw-bold mb-0"><i class="bi bi-box-arrow-right me-2 text-danger"></i>Quyết toán trả phòng</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Chọn hợp đồng khác</a>
</div>

<!-- Stepper -->
<div class="stepper">
    <div class="step done">1. Hợp đồng</div>
    <div class="step active">2. Chốt điện nước</div>
    <div class="step active">3. Chốt dịch vụ</div>
    <div class="step active">4. Kiểm tra công nợ</div>
    <div class="step active">5. Tính cọc</div>
    <div class="step active">6. Quyết toán</div>
    <div class="step">7. Thanh lý</div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <!-- Thông tin hợp đồng -->
        <div class="card chart-card mb-3">
            <div class="card-header bg-transparent fw-semibold"><i class="bi bi-file-earmark-text me-2"></i>Hợp đồng</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Phòng</dt><dd class="col-7">@Model.TenPhong</dd>
                    <dt class="col-5">Người thuê</dt><dd class="col-7">@Model.TenNguoiThue</dd>
                    <dt class="col-5">Thời hạn</dt><dd class="col-7 small">@Model.NgayBatDau.ToString("dd/MM/yy") → @Model.NgayKetThuc.ToString("dd/MM/yy")</dd>
                    <dt class="col-5">Giá thuê</dt><dd class="col-7">@Model.GiaThue.ToString("N0") đ</dd>
                    <dt class="col-5">Tiền cọc</dt><dd class="col-7 fw-bold text-primary">@Model.TienCoc.ToString("N0") đ</dd>
                </dl>
            </div>
        </div>

        <!-- Bước 2: Chốt điện nước -->
        <div class="card chart-card mb-3">
            <div class="card-header bg-transparent fw-semibold"><i class="bi bi-lightning-charge me-2 text-warning"></i>Bước 2: Chốt điện nước cuối kỳ</div>
            <div class="card-body">
                @if (string.IsNullOrEmpty(Model.KyDienNuocCuoi) && Model.ChiSoDienCu == 0 && Model.ChiSoNuocCu == 0)
                {
                    <p class="text-muted small">Phòng chưa có lịch sử chỉ số. Chỉ số cũ sẽ được tính từ 0.</p>
                }
                <form asp-action="ChotDienNuoc" method="post">
                    <input type="hidden" asp-for="MaHopDong" />
                    <input type="hidden" asp-for="ChiSoDienCu" />
                    <input type="hidden" asp-for="ChiSoNuocCu" />
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small">Chỉ số điện mới</label>
                            <input asp-for="ChiSoDienMoi" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Đơn giá điện (đ/kW)</label>
                            <input asp-for="DonGiaDien" class="form-control" type="number" min="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Chỉ số nước mới</label>
                            <input asp-for="ChiSoNuocMoi" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Đơn giá nước (đ/m³)</label>
                            <input asp-for="DonGiaNuoc" class="form-control" type="number" min="0" />
                        </div>
                    </div>
                    <div class="form-text">Chỉ số cũ: điện @Model.ChiSoDienCu.ToString("N0") · nước @Model.ChiSoNuocCu.ToString("N0")</div>
                    <button type="submit" class="btn btn-outline-primary btn-sm mt-2 w-100"><i class="bi bi-pin-angle me-1"></i>Chốt chỉ số</button>
                </form>
            </div>
        </div>

        <!-- Bước 3: Chốt dịch vụ -->
        <div class="card chart-card">
            <div class="card-header bg-transparent fw-semibold"><i class="bi bi-wifi me-2 text-info"></i>Bước 3: Dịch vụ cuối kỳ</div>
            <div class="card-body">
                @if (Model.DichVuCuoiKy.Any())
                {
                    <table class="table table-sm">
                        <thead><tr><th>Dịch vụ</th><th class="text-end">SL</th><th class="text-end">Thành tiền</th></tr></thead>
                        <tbody>
                            @foreach (var dv in Model.DichVuCuoiKy)
                            {
                                <tr><td>@dv.TenDichVu</td><td class="text-end small">@dv.SoLuong.ToString("N0") @dv.DonViTinh</td><td class="text-end">@dv.ThanhTien.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted small mb-2">Không có bản ghi dịch vụ gần nhất.</p>
                }
                <form asp-action="ChotDichVu" method="post">
                    <input type="hidden" asp-for="MaHopDong" />
                    <button type="submit" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-arrow-clockwise me-1"></i>Kiểm tra / chốt dịch vụ</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- Bước 4: Công nợ -->
        <div class="card chart-card mb-3">
            <div class="card-header bg-transparent fw-semibold"><i class="bi bi-exclamation-circle me-2 text-danger"></i>Bước 4: Công nợ chưa thanh toán</div>
            <div class="card-body">
                @if (Model.HoaDonChuaThanhToan.Any())
                {
                    <table class="table table-sm mb-2">
                        <thead><tr><th>Hóa đơn</th><th>Kỳ</th><th class="text-end">Tổng tiền</th></tr></thead>
                        <tbody>
                            @foreach (var inv in Model.HoaDonChuaThanhToan)
                            {
                                <tr><td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.MaHoaDon">@inv.MaHoaDonKyHieu</a></td><td>@inv.KyHoaDon</td><td class="text-end">@inv.TongTien.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-success small mb-2"><i class="bi bi-check-circle me-1"></i>Không còn hóa đơn chưa thanh toán.</p>
                }
                <div class="d-flex justify-content-between border-top pt-2">
                    <span class="fw-semibold">Tổng công nợ trước trả phòng:</span>
                    <span class="fw-bold text-danger">@Model.CongNoTruocTraPhong.ToString("N0") đ</span>
                </div>
            </div>
        </div>

        <!-- Bước 5-6: Quyết toán -->
        <div class="card chart-card">
            <div class="card-header bg-transparent fw-semibold"><i class="bi bi-calculator me-2 text-primary"></i>Bước 5-6: Tính cọc &amp; quyết toán</div>
            <div class="card-body">
                <form asp-action="Confirm" method="post" id="settleForm" data-confirm="Xác nhận quyết toán trả phòng? Hợp đồng sẽ được thanh lý và phòng chuyển trạng thái mới. Thao tác chỉ thực hiện được MỘT lần.">
                    <input type="hidden" asp-for="MaHopDong" />
                    <input type="hidden" asp-for="TenPhong" />
                    <input type="hidden" asp-for="TenNguoiThue" />
                    <input type="hidden" asp-for="GiaThue" />
                    <input type="hidden" asp-for="TienCoc" />
                    <input type="hidden" asp-for="NgayBatDau" />
                    <input type="hidden" asp-for="NgayKetThuc" />
                    <input type="hidden" asp-for="CongNoTruocTraPhong" />
                    <input type="hidden" asp-for="KyDienNuocCuoi" />
                    <input type="hidden" asp-for="KyDichVuCuoi" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="NgayTraPhong" class="form-label"></label>
                            <input asp-for="NgayTraPhong" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TienPhatSinhCuoiKy" class="form-label">Phát sinh cuối kỳ khác (đ)</label>
                            <input asp-for="TienPhatSinhCuoiKy" class="form-control" type="number" min="0" id="phatSinhInput" />
                            <div class="form-text">Tiền điện nước + dịch vụ đã chốt sẽ được hệ thống tự cộng khi quyết toán.</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TrangThaiPhongSauTra" class="form-label"></label>
                            <select asp-for="TrangThaiPhongSauTra" class="form-select" asp-items="Html.GetEnumSelectList<RoomStatus>()"></select>
                            <div class="form-text">Phòng chuyển Trống hoặc Đang sửa chữa sau trả phòng.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="GhiChu" class="form-label"></label>
                            <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="table-responsive mt-3">
                        <table class="table table-bordered mb-0" id="settleTable">
                            <tbody>
                                <tr><td>Công nợ trước trả phòng</td><td class="text-end">@Model.CongNoTruocTraPhong.ToString("N0") đ</td></tr>
                                <tr><td>Tiền phát sinh cuối kỳ (điện nước + dịch vụ chốt)</td><td class="text-end" id="phatSinhCell">Được tính khi quyết toán</td></tr>
                                <tr class="table-warning fw-semibold"><td>Khoản phải thu cuối cùng = Công nợ + Phát sinh</td><td class="text-end" id="khoanPhaiThuCell">@Model.CongNoTruocTraPhong.ToString("N0") đ</td></tr>
                                <tr><td>Tiền cọc ban đầu</td><td class="text-end">@Model.TienCoc.ToString("N0") đ</td></tr>
                                <tr><td>Tiền khấu trừ cọc = MIN(Cọc, Phải thu)</td><td class="text-end" id="khauTruCell">-</td></tr>
                                <tr class="table-success fw-semibold"><td>Tiền hoàn cọc = MAX(0, Cọc − Phải thu)</td><td class="text-end" id="hoanCocCell">-</td></tr>
                                <tr class="table-danger fw-semibold"><td>Tiền phải trả thêm = MAX(0, Phải thu − Cọc)</td><td class="text-end" id="traThemCell">-</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-warning small mt-3 mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Khoản phải thu cuối cùng và các số liệu quyết toán được tính lại từ database khi bấm quyết toán — số tiền phát sinh bạn nhập chỉ là mục khác chưa ghi thành hóa đơn.
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-check2-circle me-1"></i>Quyết toán trả phòng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preview nhanh công thức quyết toán phía client (server vẫn tính lại chính xác từ DB)
        const congNo = @Model.CongNoTruocTraPhong;
        const tienCoc = @Model.TienCoc;
        const input = document.getElementById('phatSinhInput');
        function recalcSettle() {
            const ps = parseFloat(input?.value || 0);
            const phaiThu = congNo + ps;
            const khauTru = Math.min(tienCoc, phaiThu);
            const hoan = Math.max(0, tienCoc - phaiThu);
            const them = Math.max(0, phaiThu - tienCoc);
            const fmt = n => new Intl.NumberFormat('vi-VN').format(n) + ' đ';
            document.getElementById('khoanPhaiThuCell').textContent = fmt(phaiThu);
            document.getElementById('khauTruCell').textContent = fmt(khauTru);
            document.getElementById('hoanCocCell').textContent = fmt(hoan);
            document.getElementById('traThemCell').textContent = fmt(them);
        }
        input?.addEventListener('input', recalcSettle);
        recalcSettle();
    </script>
}
