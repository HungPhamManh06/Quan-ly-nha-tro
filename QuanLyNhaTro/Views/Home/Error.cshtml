@{
    ViewData["Title"] = "Lỗi hệ thống";
    Layout = "_Layout";
}

<div class="empty-state" style="padding-top:5rem">
    <div class="empty-icon" style="background:var(--color-danger-soft);color:var(--color-danger)"><i class="bi bi-exclamation-triangle"></i></div>
    <div class="empty-title" style="font-size:1.4rem">Đã xảy ra lỗi</div>
    <p class="empty-desc">Hệ thống gặp sự cố khi xử lý yêu cầu. Vui lòng thử lại sau — nếu lỗi tiếp diễn, liên hệ quản trị viên.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-1"></i>Về trang chủ</a>
</div>
