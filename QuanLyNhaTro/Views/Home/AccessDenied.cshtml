@{
    ViewData["Title"] = "Truy cập bị từ chối";
    Layout = "_Layout";
}

<div class="empty-state" style="padding-top:5rem">
    <div class="empty-icon" style="background:var(--color-danger-soft);color:var(--color-danger)"><i class="bi bi-shield-lock"></i></div>
    <div class="empty-title" style="font-size:1.4rem">Truy cập bị từ chối</div>
    <p class="empty-desc">Bạn không có quyền truy cập trang này. Vui lòng đăng nhập bằng tài khoản Chủ trọ.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary"><i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập</a>
</div>
