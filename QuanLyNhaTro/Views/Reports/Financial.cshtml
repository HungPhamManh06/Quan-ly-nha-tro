@{
    ViewData["Title"] = "Doanh thu & công nợ";
    var fin = (ReportFinancialViewModel)ViewBag.Financial;
    var doanhThuThang = (List<DoanhThuThangItem>)ViewBag.DoanhThuThang;
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Thống kê &amp; báo cáo</a>

<div class="page-header">
    <div>
        <h1 class="page-title">Doanh thu &amp; công nợ</h1>
        <p class="page-subtitle">Tổng hợp theo kỳ</p>
    </div>
    <div class="page-actions">
        <a asp-action="Export" asp-route-type="revenue" asp-route-format="excel" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body toolbar py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Từ kỳ</label>
                <input type="month" name="tuKy" value="@ViewBag.TuKy" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Đến kỳ</label>
                <input type="month" name="denKy" value="@ViewBag.DenKy" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Năm (biểu đồ)</label>
                <input type="number" name="nam" value="@ViewBag.Nam" class="form-control" min="2000" max="2100" />
            </div>
            <div class="col-md-2"><button class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Lọc</button></div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card kpi-card">
            <div class="card-body">
                <div class="kpi-top"><span class="kpi-icon success"><i class="bi bi-cash-stack"></i></span><span class="kpi-label">Tổng doanh thu (đã thu)</span></div>
                <div class="kpi-value money text-success">@fin.TongDoanhThu.ToString("N0") đ</div>
                <div class="kpi-sub">@fin.SoHoaDonDaTT hóa đơn</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card">
            <div class="card-body">
                <div class="kpi-top"><span class="kpi-icon danger"><i class="bi bi-exclamation-circle"></i></span><span class="kpi-label">Tổng công nợ (chưa thu)</span></div>
                <div class="kpi-value money text-danger">@fin.TongCongNo.ToString("N0") đ</div>
                <div class="kpi-sub">@fin.SoHoaDonChuaTT hóa đơn</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header py-2">Doanh thu - công nợ theo tháng năm @ViewBag.Nam</div>
            <div class="card-body py-2">
                <div class="chart-box-sm"><canvas id="financeChart"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Tháng</th><th class="text-end">Doanh thu (đã thanh toán)</th><th class="text-end">Công nợ (chưa thanh toán)</th></tr></thead>
            <tbody>
                @foreach (var d in doanhThuThang)
                {
                    <tr>
                        <td class="td-strong">@d.Thang</td>
                        <td class="text-end money text-success">@d.DoanhThu.ToString("N0") đ</td>
                        <td class="text-end money text-danger">@d.CongNo.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";
        Chart.defaults.font.size = 11.5;
        Chart.defaults.color = '#64748B';
        new Chart(document.getElementById('financeChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(doanhThuThang.Select(d => d.Thang))),
                datasets: [
                    { label: 'Doanh thu', data: @Html.Raw(Json.Serialize(doanhThuThang.Select(d => d.DoanhThu))), backgroundColor: 'rgba(22,163,74,.8)', hoverBackgroundColor: '#16A34A', borderRadius: 5, maxBarThickness: 18 },
                    { label: 'Công nợ', data: @Html.Raw(Json.Serialize(doanhThuThang.Select(d => d.CongNo))), backgroundColor: 'rgba(220,38,38,.8)', hoverBackgroundColor: '#DC2626', borderRadius: 5, maxBarThickness: 18 }
                ]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true, pointStyle: 'circle', padding: 14 } } },
                scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grid: { color: '#EEF2F7', drawTicks: false } } }
            }
        });
    </script>
}
