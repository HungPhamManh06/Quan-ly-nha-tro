@model List<Room>
@{
    ViewData["Title"] = "Báo cáo phòng";
    var trong = Model.Count(r => r.TrangThai == RoomStatus.Trong);
    var daCoc = Model.Count(r => r.TrangThai == RoomStatus.DaCoc);
    var dangThue = Model.Count(r => r.TrangThai == RoomStatus.DangThue);
    var dangSua = Model.Count(r => r.TrangThai == RoomStatus.DangSuaChua);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="fw-bold mb-0"><i class="bi bi-door-open me-2 text-primary"></i>Báo cáo phòng</h3>
    <div>
        <a asp-action="Export" asp-route-type="rooms" asp-route-format="excel" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Menu báo cáo</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col"><div class="card stat-card text-center p-3"><div class="text-muted small">Tổng phòng</div><div class="fs-3 fw-bold">@Model.Count</div></div></div>
    <div class="col"><div class="card stat-card text-center p-3"><div class="text-muted small">Trống</div><div class="fs-3 fw-bold text-success">@trong</div></div></div>
    <div class="col"><div class="card stat-card text-center p-3"><div class="text-muted small">Đã cọc</div><div class="fs-3 fw-bold text-primary">@daCoc</div></div></div>
    <div class="col"><div class="card stat-card text-center p-3"><div class="text-muted small">Đang thuê</div><div class="fs-3 fw-bold text-warning">@dangThue</div></div></div>
    <div class="col"><div class="card stat-card text-center p-3"><div class="text-muted small">Đang sửa chữa</div><div class="fs-3 fw-bold text-danger">@dangSua</div></div></div>
</div>

<div class="card chart-card">
    <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
            <thead><tr><th>Mã phòng</th><th>Tên phòng</th><th>Loại</th><th class="text-end">Diện tích</th><th class="text-end">Giá phòng</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.MaPhongKyHieu</td><td>@r.TenPhong</td><td>@r.LoaiPhong</td>
                        <td class="text-end">@(r.DienTich?.ToString("N1") ?? "-")</td>
                        <td class="text-end">@r.GiaPhong.ToString("N0")</td>
                        <td>@r.TrangThai.GetDisplayName()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
