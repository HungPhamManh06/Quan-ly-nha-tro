@model List<Room>
@{
    ViewData["Title"] = "Báo cáo phòng";
    var trong = Model.Count(r => r.TrangThai == RoomStatus.Trong);
    var daCoc = Model.Count(r => r.TrangThai == RoomStatus.DaCoc);
    var dangThue = Model.Count(r => r.TrangThai == RoomStatus.DangThue);
    var dangSua = Model.Count(r => r.TrangThai == RoomStatus.DangSuaChua);
    string Badge(RoomStatus s) => s switch
    {
        RoomStatus.Trong => "badge-trong",
        RoomStatus.DaCoc => "badge-dacoc",
        RoomStatus.DangThue => "badge-dangthue",
        RoomStatus.DangSuaChua => "badge-dangsua",
        _ => "bg-secondary"
    };
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Thống kê &amp; báo cáo</a>

<div class="page-header">
    <div>
        <h1 class="page-title">Báo cáo phòng</h1>
        <p class="page-subtitle">Tình trạng toàn bộ phòng trong nhà trọ</p>
    </div>
    <div class="page-actions">
        <a asp-action="Export" asp-route-type="rooms" asp-route-format="excel" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col"><div class="card kpi-card text-center py-3"><div class="kpi-value">@Model.Count</div><div class="kpi-label">Tổng phòng</div></div></div>
    <div class="col"><div class="card kpi-card text-center py-3"><div class="kpi-value text-success">@trong</div><div class="kpi-label">Trống</div></div></div>
    <div class="col"><div class="card kpi-card text-center py-3"><div class="kpi-value text-primary">@daCoc</div><div class="kpi-label">Đã cọc</div></div></div>
    <div class="col"><div class="card kpi-card text-center py-3"><div class="kpi-value" style="color:#B45309">@dangThue</div><div class="kpi-label">Đang thuê</div></div></div>
    <div class="col"><div class="card kpi-card text-center py-3"><div class="kpi-value text-danger">@dangSua</div><div class="kpi-label">Sửa chữa</div></div></div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Mã phòng</th><th>Tên phòng</th><th class="d-none d-md-table-cell">Loại</th><th class="text-end">Diện tích</th><th class="text-end">Giá phòng</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="cell-code">@r.MaPhongKyHieu</td>
                        <td>@r.TenPhong</td>
                        <td class="d-none d-md-table-cell">@r.LoaiPhong</td>
                        <td class="text-end num">@(r.DienTich?.ToString("N1") ?? "—") m²</td>
                        <td class="text-end money">@r.GiaPhong.ToString("N0") đ</td>
                        <td><span class="badge @Badge(r.TrangThai)">@r.TrangThai.GetDisplayName()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
