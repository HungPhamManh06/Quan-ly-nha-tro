@model List<Contract>
@{
    ViewData["Title"] = "Báo cáo hợp đồng";
    var today = DateTime.Today;
    var hieuLuc = Model.Count(c => c.TrangThai == ContractStatus.HieuLuc);
    var sapHetHan = Model.Count(c => c.TrangThai != ContractStatus.DaThanhLy && c.NgayKetThuc >= today && c.NgayKetThuc <= today.AddDays(30));
    var daThanhLy = Model.Count(c => c.TrangThai == ContractStatus.DaThanhLy);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="fw-bold mb-0"><i class="bi bi-file-earmark-text me-2 text-secondary"></i>Báo cáo hợp đồng</h3>
    <div>
        <a asp-action="Export" asp-route-type="contracts" asp-route-format="excel" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Menu báo cáo</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card stat-card text-center p-3"><div class="text-muted small">Đang hiệu lực</div><div class="fs-3 fw-bold text-success">@hieuLuc</div></div></div>
    <div class="col-md-4"><div class="card stat-card text-center p-3"><div class="text-muted small">Sắp hết hạn (30 ngày)</div><div class="fs-3 fw-bold text-warning">@sapHetHan</div></div></div>
    <div class="col-md-4"><div class="card stat-card text-center p-3"><div class="text-muted small">Đã thanh lý</div><div class="fs-3 fw-bold text-secondary">@daThanhLy</div></div></div>
</div>

<div class="card chart-card">
    <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
            <thead><tr><th>Mã HĐ</th><th>Phòng</th><th>Người thuê</th><th>Bắt đầu</th><th>Kết thúc</th><th class="text-end">Giá thuê</th><th class="text-end">Cọc</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.MaHopDongKyHieu</td><td>@c.Room?.MaPhongKyHieu</td><td>@c.Tenant?.HoTen</td>
                        <td>@c.NgayBatDau.ToString("dd/MM/yyyy")</td><td>@c.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@c.GiaThue.ToString("N0")</td><td class="text-end">@c.TienCoc.ToString("N0")</td>
                        <td><span class="badge @(c.TrangThai == ContractStatus.DaThanhLy ? "badge-dathanhly" : "badge-hieuluc")">@c.TrangThai.GetDisplayName()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
