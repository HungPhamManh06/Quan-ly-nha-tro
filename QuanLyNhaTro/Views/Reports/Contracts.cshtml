@model List<Contract>
@{
    ViewData["Title"] = "Báo cáo hợp đồng";
    var today = DateTime.Today;
    var hieuLuc = Model.Count(c => c.TrangThai == ContractStatus.HieuLuc);
    var sapHetHan = Model.Count(c => c.TrangThai != ContractStatus.DaThanhLy && c.NgayKetThuc >= today && c.NgayKetThuc <= today.AddDays(30));
    var daThanhLy = Model.Count(c => c.TrangThai == ContractStatus.DaThanhLy);
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Thống kê &amp; báo cáo</a>

<div class="page-header">
    <div>
        <h1 class="page-title">Báo cáo hợp đồng</h1>
        <p class="page-subtitle">Hiệu lực, sắp hết hạn và đã thanh lý</p>
    </div>
    <div class="page-actions">
        <a asp-action="Export" asp-route-type="contracts" asp-route-format="excel" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card kpi-card text-center py-3"><div class="kpi-value text-success">@hieuLuc</div><div class="kpi-label">Đang hiệu lực</div></div></div>
    <div class="col-md-4"><div class="card kpi-card text-center py-3"><div class="kpi-value" style="color:#B45309">@sapHetHan</div><div class="kpi-label">Sắp hết hạn (30 ngày)</div></div></div>
    <div class="col-md-4"><div class="card kpi-card text-center py-3"><div class="kpi-value text-muted">@daThanhLy</div><div class="kpi-label">Đã thanh lý</div></div></div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Mã HĐ</th><th>Phòng</th><th class="d-none d-md-table-cell">Người thuê</th><th class="d-none d-lg-table-cell">Bắt đầu</th><th>Kết thúc</th><th class="text-end">Giá thuê</th><th class="d-none d-lg-table-cell text-end">Cọc</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="cell-code">@c.MaHopDongKyHieu</td>
                        <td>@c.Room?.MaPhongKyHieu</td>
                        <td class="d-none d-md-table-cell">@c.Tenant?.HoTen</td>
                        <td class="d-none d-lg-table-cell num">@c.NgayBatDau.ToString("dd/MM/yyyy")</td>
                        <td class="num">@c.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                        <td class="text-end money">@c.GiaThue.ToString("N0") đ</td>
                        <td class="d-none d-lg-table-cell text-end money td-muted">@c.TienCoc.ToString("N0") đ</td>
                        <td><span class="badge @(c.TrangThai == ContractStatus.DaThanhLy ? "badge-dathanhly" : "badge-hieuluc")">@c.TrangThai.GetDisplayName()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
