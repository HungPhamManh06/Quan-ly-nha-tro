@model List<TenantReportItem>
@{
    ViewData["Title"] = "Báo cáo người thuê";
    var dangThue = Model.Count(t => t.TrangThai == "Đang thuê");
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="fw-bold mb-0"><i class="bi bi-people me-2 text-info"></i>Báo cáo người thuê</h3>
    <div>
        <a asp-action="Export" asp-route-type="tenants" asp-route-format="excel" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Menu báo cáo</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card stat-card text-center p-3"><div class="text-muted small">Tổng người thuê</div><div class="fs-3 fw-bold">@Model.Count</div></div></div>
    <div class="col-md-4"><div class="card stat-card text-center p-3"><div class="text-muted small">Đang thuê</div><div class="fs-3 fw-bold text-success">@dangThue</div></div></div>
    <div class="col-md-4"><div class="card stat-card text-center p-3"><div class="text-muted small">Chưa thuê / đã trả</div><div class="fs-3 fw-bold text-secondary">@(Model.Count - dangThue)</div></div></div>
</div>

<div class="card chart-card">
    <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
            <thead><tr><th>Họ tên</th><th>CCCD</th><th>SĐT</th><th>Phòng hiện tại</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.HoTen</td><td>@t.CCCD</td><td>@t.SoDienThoai</td>
                        <td>@(string.IsNullOrEmpty(t.PhongHienTai) ? "-" : t.PhongHienTai)</td>
                        <td><span class="badge @(t.TrangThai == "Đang thuê" ? "badge-hieuluc" : "badge-dathanhly")">@t.TrangThai</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
