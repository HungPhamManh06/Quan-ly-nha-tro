@model List<UtilityReportItem>
@{
    ViewData["Title"] = "Báo cáo điện nước";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Thống kê &amp; báo cáo</a>

<div class="page-header">
    <div>
        <h1 class="page-title">Báo cáo điện nước</h1>
        <p class="page-subtitle">Chỉ số, số dùng và tiền theo phòng và tháng</p>
    </div>
    <div class="page-actions">
        <a asp-action="Export" asp-route-type="utilities" asp-route-format="excel" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body toolbar py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Từ kỳ</label>
                <input type="month" name="tuKy" value="@ViewContext.HttpContext.Request.Query["tuKy"]" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Đến kỳ</label>
                <input type="month" name="denKy" value="@ViewContext.HttpContext.Request.Query["denKy"]" class="form-control" />
            </div>
            <div class="col-md-2"><button class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Lọc</button></div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Kỳ</th><th>Phòng</th>
                    <th class="d-none d-lg-table-cell text-end">Điện cũ → mới</th><th class="text-end">Số dùng</th><th class="text-end">Tiền điện</th>
                    <th class="d-none d-xl-table-cell text-end">Nước cũ → mới</th><th class="text-end">Tiền nước</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="td-strong">@u.KyGhi</td>
                        <td class="cell-code">@u.MaPhong</td>
                        <td class="d-none d-lg-table-cell text-end small num td-muted">@u.ChiSoDienCu.ToString("N0") → @u.ChiSoDienMoi.ToString("N0")</td>
                        <td class="text-end num">@u.SoDienSuDung.ToString("N0") kW</td>
                        <td class="text-end money fw-semibold">@u.TienDien.ToString("N0") đ</td>
                        <td class="d-none d-xl-table-cell text-end small num td-muted">@u.ChiSoNuocCu.ToString("N0") → @u.ChiSoNuocMoi.ToString("N0")</td>
                        <td class="text-end money fw-semibold">@u.TienNuoc.ToString("N0") đ</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="td-muted text-center py-4">Chưa có dữ liệu.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
