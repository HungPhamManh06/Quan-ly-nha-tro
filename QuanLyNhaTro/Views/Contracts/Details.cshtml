@model Contract
@{
    ViewData["Title"] = "Chi tiết hợp đồng";
    var conHieuLuc = Model.TrangThai != ContractStatus.DaThanhLy;
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Quản lý hợp đồng</a>

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <div class="brand-icon" style="width:52px;height:52px;border-radius:14px;font-size:1.3rem"><i class="bi bi-file-earmark-text"></i></div>
        <div>
            <h1 class="page-title mb-0">@Model.MaHopDongKyHieu</h1>
            <div class="mt-1">
                <span class="badge @(conHieuLuc ? "badge-hieuluc" : "badge-dathanhly")">@Model.TrangThai.GetDisplayName()</span>
                <span class="mini-tag ms-1">@Model.Room?.MaPhongKyHieu</span>
                <span class="mini-tag ms-1">@Model.Tenant?.HoTen</span>
            </div>
        </div>
    </div>
    <div class="page-actions">
        @if (conHieuLuc)
        {
            <a asp-action="Renew" asp-route-id="@Model.MaHopDong" class="btn btn-primary"><i class="bi bi-arrow-repeat me-1"></i>Gia hạn</a>
            <a asp-controller="MoveOut" asp-action="Settle" asp-route-id="@Model.MaHopDong" class="btn btn-danger"><i class="bi bi-box-arrow-right me-1"></i>Trả phòng</a>
        }
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-list me-1"></i>Danh sách</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Thông tin hợp đồng</div>
            <div class="card-body">
                <dl>
                    <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Mã hợp đồng</dt><dd class="fw-semibold">@Model.MaHopDongKyHieu</dd></div>
                    <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Phòng</dt><dd><a asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.MaPhong">@Model.Room?.MaPhongKyHieu · @Model.Room?.TenPhong</a></dd></div>
                    <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Người thuê</dt><dd><a asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.MaNguoiThue">@Model.Tenant?.HoTen</a></dd></div>
                    <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Ngày bắt đầu</dt><dd class="num">@Model.NgayBatDau.ToString("dd/MM/yyyy")</dd></div>
                    <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Ngày kết thúc</dt><dd class="num">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd></div>
                    <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Giá thuê</dt><dd class="money fw-semibold">@Model.GiaThue.ToString("N0") đ/tháng</dd></div>
                    <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Tiền cọc</dt><dd class="money fw-semibold">@Model.TienCoc.ToString("N0") đ</dd></div>
                    <div class="d-flex justify-content-between py-1"><dt class="text-muted fw-normal small">Ghi chú</dt><dd class="text-end">@(Model.GhiChu ?? "—")</dd></div>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-clock-history me-2"></i>Lịch sử hợp đồng (@Model.Histories.Count)</div>
            <div class="card-body">
                @if (Model.Histories.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var h in Model.Histories.OrderByDescending(h => h.ThoiGian))
                        {
                            <li class="mb-2 pb-2 border-bottom d-flex gap-2">
                                <span class="mini-tag flex-shrink-0">@h.HanhDong</span>
                                <div class="flex-grow-1">
                                    <div class="small">@h.NoiDung</div>
                                    <div class="small td-muted">@h.ThoiGian.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="td-muted">Chưa có lịch sử.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header"><i class="bi bi-receipt me-2"></i>Hóa đơn theo hợp đồng (@Model.Invoices.Count)</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead><tr><th>Mã HĐ</th><th>Kỳ</th><th class="text-end">Tiền phòng</th><th class="text-end">Điện</th><th class="text-end">Nước</th><th class="text-end">DV</th><th class="text-end">Tổng</th><th>Trạng thái</th></tr></thead>
                    <tbody>
                        @foreach (var inv in Model.Invoices.OrderByDescending(i => i.KyHoaDon))
                        {
                            <tr>
                                <td><a class="cell-code" asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.MaHoaDon">@inv.MaHoaDonKyHieu</a></td>
                                <td>@inv.KyHoaDon</td>
                                <td class="text-end money">@inv.TienPhong.ToString("N0")</td>
                                <td class="text-end money">@inv.TienDien.ToString("N0")</td>
                                <td class="text-end money">@inv.TienNuoc.ToString("N0")</td>
                                <td class="text-end money">@inv.TienDichVu.ToString("N0")</td>
                                <td class="text-end money fw-bold">@inv.TongTien.ToString("N0")</td>
                                <td><span class="badge @(inv.TrangThaiThanhToan == InvoicePaymentStatus.DaThanhToan ? "badge-dathanhtoan" : "badge-chuathanhtoan")">@inv.TrangThaiThanhToan.GetDisplayName()</span></td>
                            </tr>
                        }
                        @if (!Model.Invoices.Any()) { <tr><td colspan="8" class="td-muted text-center py-3">Chưa có hóa đơn.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
