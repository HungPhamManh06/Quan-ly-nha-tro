@model List<Contract>
@{
    ViewData["Title"] = "Quản lý hợp đồng";
    var today = DateTime.Today;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý hợp đồng</h1>
        <p class="page-subtitle">Theo dõi hiệu lực, gia hạn và thanh lý hợp đồng thuê</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Lập hợp đồng</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body toolbar py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4 col-lg-4">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:#94A3B8"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="padding-left:34px" placeholder="Tìm theo mã HĐ / phòng / người thuê…" />
                </div>
            </div>
            <div class="col-md-3 col-lg-2">
                <select name="trangThai" class="form-select" asp-items="Html.GetEnumSelectList<ContractStatus>()">
                    <option value="">Tất cả trạng thái</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-3">
                <div class="form-check form-switch" style="padding-top:.35rem">
                    <input class="form-check-input" type="checkbox" name="sapHetHan" value="true" @(ViewBag.SapHetHan == true ? "checked" : "") id="sapHetHanSwitch" onchange="this.form.submit()">
                    <label class="form-check-label small" for="sapHetHanSwitch">Chỉ hiện sắp hết hạn (30 ngày)</label>
                </div>
            </div>
            <div class="col-md-2 col-lg-2">
                <button class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Lọc</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-file-earmark-text"></i></div>
            <div class="empty-title">Chưa có hợp đồng nào</div>
            <p class="empty-desc">Lập hợp đồng đầu tiên để cho thuê phòng.</p>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Lập hợp đồng</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Phòng</th>
                        <th class="d-none d-md-table-cell">Người thuê</th>
                        <th class="d-none d-lg-table-cell">Thời hạn</th>
                        <th class="text-end">Giá thuê</th>
                        <th class="d-none d-lg-table-cell text-end">Cọc</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        var conHieuLuc = c.TrangThai != ContractStatus.DaThanhLy;
                        var conSoNgay = (c.NgayKetThuc.Date - today).Days;
                        <tr>
                            <td class="cell-code">@c.MaHopDongKyHieu</td>
                            <td><a asp-controller="Rooms" asp-action="Details" asp-route-id="@c.MaPhong" class="fw-semibold">@c.Room?.MaPhongKyHieu</a></td>
                            <td class="d-none d-md-table-cell">@c.Tenant?.HoTen</td>
                            <td class="d-none d-lg-table-cell small num">@c.NgayBatDau.ToString("dd/MM/yy") → @c.NgayKetThuc.ToString("dd/MM/yy")</td>
                            <td class="text-end money">@c.GiaThue.ToString("N0") đ</td>
                            <td class="d-none d-lg-table-cell text-end money td-muted">@c.TienCoc.ToString("N0") đ</td>
                            <td>
                                <span class="badge @(c.TrangThai == ContractStatus.DaThanhLy ? "badge-dathanhly" : "badge-hieuluc")">@c.TrangThai.GetDisplayName()</span>
                                @if (conHieuLuc && conSoNgay <= 30)
                                {
                                    <div class="small text-warning mt-1 fw-semibold">
                                        <i class="bi bi-exclamation-triangle me-1"></i>@(conSoNgay >= 0 ? $"còn {conSoNgay} ngày" : $"quá hạn {-conSoNgay} ngày")
                                    </div>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn-dots" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Thao tác"><i class="bi bi-three-dots-vertical"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@c.MaHopDong"><i class="bi bi-eye"></i>Chi tiết</a></li>
                                        @if (conHieuLuc)
                                        {
                                            <li><a class="dropdown-item" asp-action="Renew" asp-route-id="@c.MaHopDong"><i class="bi bi-arrow-repeat"></i>Gia hạn</a></li>
                                            <li>
                                                <form asp-action="Liquidate" asp-route-id="@c.MaHopDong" method="post"
                                                      data-confirm="Hợp đồng @c.MaHopDongKyHieu của phòng @c.Room?.MaPhongKyHieu sẽ được chuyển sang trạng thái đã thanh lý. Hành động này không thể hoàn tác." data-confirm-danger="true" data-confirm-title="Thanh lý hợp đồng?">
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-journal-check"></i>Thanh lý</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
