@model RenewContractViewModel
@{
    ViewData["Title"] = "Gia hạn hợp đồng";
}

<a asp-action="Details" asp-route-id="@Model.MaHopDong" class="back-link"><i class="bi bi-arrow-left"></i>Chi tiết hợp đồng</a>

<div class="page-header">
    <div>
        <h1 class="page-title">Gia hạn hợp đồng @Model.MaHopDongKyHieu</h1>
        <p class="page-subtitle">Kéo dài thời hạn thuê — lịch sử gia hạn được lưu lại</p>
    </div>
</div>

<div class="card mb-3" style="max-width:960px">
    <div class="card-header">Thông tin hợp đồng hiện tại</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3"><div class="kpi-label">Phòng</div><div class="fw-semibold">@Model.TenPhong</div></div>
            <div class="col-md-3"><div class="kpi-label">Người thuê</div><div class="fw-semibold">@Model.TenNguoiThue</div></div>
            <div class="col-md-3"><div class="kpi-label">Thời hạn</div><div class="fw-semibold num">@Model.NgayBatDau.ToString("dd/MM/yyyy") → @Model.NgayKetThuc.ToString("dd/MM/yyyy")</div></div>
            <div class="col-md-3"><div class="kpi-label">Giá thuê / cọc</div><div class="fw-semibold money">@Model.GiaThue.ToString("N0") đ · cọc @Model.TienCoc.ToString("N0") đ</div></div>
        </div>
    </div>
</div>

<div class="card" style="max-width:960px">
    <div class="card-header">Thông tin gia hạn</div>
    <div class="card-body p-4">
        <form asp-action="Renew" method="post">
            <input type="hidden" asp-for="MaHopDong" />
            <input type="hidden" asp-for="MaHopDongKyHieu" />
            <input type="hidden" asp-for="TenPhong" />
            <input type="hidden" asp-for="TenNguoiThue" />
            <input type="hidden" asp-for="NgayBatDau" />
            <input type="hidden" asp-for="NgayKetThuc" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="NgayKetThucMoi" class="form-label"></label>
                    <input asp-for="NgayKetThucMoi" class="form-control" type="date" />
                    <span asp-validation-for="NgayKetThucMoi" class="text-danger small"></span>
                    <div class="form-text">Phải sau ngày kết thúc hiện tại (@Model.NgayKetThuc.ToString("dd/MM/yyyy")).</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="GiaThueMoi" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="GiaThueMoi" class="form-control" type="number" min="0" placeholder="Giữ nguyên @Model.GiaThue.ToString("N0")" />
                        <span class="input-group-text">đ/tháng</span>
                    </div>
                    <span asp-validation-for="GiaThueMoi" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TienCocMoi" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="TienCocMoi" class="form-control" type="number" min="0" placeholder="Giữ nguyên @Model.TienCoc.ToString("N0")" />
                        <span class="input-group-text">đ</span>
                    </div>
                    <span asp-validation-for="TienCocMoi" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label"></label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2" placeholder="Lý do / ghi chú gia hạn (không bắt buộc)"></textarea>
                </div>
            </div>
            <div class="d-flex gap-2 pt-3 mt-3 border-top">
                <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-repeat me-1"></i>Gia hạn</button>
                <a asp-action="Details" asp-route-id="@Model.MaHopDong" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
