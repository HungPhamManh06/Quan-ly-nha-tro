@model List<Room>
@{
    ViewData["Title"] = "Quản lý phòng";
}
@functions {
    string Badge(RoomStatus s) => s switch
    {
        RoomStatus.Trong => "badge-trong",
        RoomStatus.DaCoc => "badge-dacoc",
        RoomStatus.DangThue => "badge-dangthue",
        RoomStatus.DangSuaChua => "badge-dangsua",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="fw-bold mb-0"><i class="bi bi-door-open me-2 text-primary"></i>Quản lý phòng</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm phòng</a>
</div>

<div class="card chart-card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Tìm kiếm theo mã / tên phòng</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="VD: P101 hoặc Phòng 101" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Trạng thái</label>
                <select name="trangThai" class="form-select" asp-items="Html.GetEnumSelectList<RoomStatus>()">
                    <option value="">-- Tất cả --</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Tìm kiếm</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card chart-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Mã phòng</th>
                    <th>Tên phòng</th>
                    <th>Loại</th>
                    <th class="text-end">Giá (đ/tháng)</th>
                    <th>Người thuê</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Chưa có phòng nào.</td></tr>
                }
                @foreach (var room in Model)
                {
                    var today = DateTime.Today;
                    var current = room.Contracts.FirstOrDefault(c => c.TrangThai != ContractStatus.DaThanhLy && c.NgayBatDau <= today && c.NgayKetThuc >= today);
                    <tr>
                        <td class="fw-semibold">@room.MaPhongKyHieu</td>
                        <td>@room.TenPhong</td>
                        <td>@room.LoaiPhong</td>
                        <td class="text-end">@room.GiaPhong.ToString("N0")</td>
                        <td>@(current?.Tenant?.HoTen ?? "-")</td>
                        <td><span class="badge @Badge(room.TrangThai)">@room.TrangThai.GetDisplayName()</span></td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@room.MaPhong" class="btn btn-outline-info btn-sm-icon" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@room.MaPhong" class="btn btn-outline-warning btn-sm-icon" title="Sửa"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@room.MaPhong" method="post" class="d-inline"
                                  data-confirm="Bạn có chắc muốn xóa phòng @room.MaPhongKyHieu? (Nếu phòng đã phát sinh dữ liệu nghiệp vụ, hệ thống sẽ chuyển sang Ngừng sử dụng thay vì xóa)">
                                <button type="submit" class="btn btn-outline-danger btn-sm-icon" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
