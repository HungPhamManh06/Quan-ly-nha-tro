@model List<UtilityReading>
@{
    ViewData["Title"] = "Quản lý điện nước";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="fw-bold mb-0"><i class="bi bi-lightning-charge me-2 text-warning"></i>Quản lý điện nước</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Ghi chỉ số</a>
</div>

<div class="card chart-card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Tìm phòng</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="VD: P101" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted">Kỳ ghi (yyyy-MM)</label>
                <select name="ky" class="form-select" asp-items="ViewBag.KyList">
                    <option value="">-- Tất cả kỳ --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Tìm</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card chart-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Kỳ</th>
                    <th>Phòng</th>
                    <th class="text-end">Điện cũ → mới</th>
                    <th class="text-end">Số dùng</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Tiền điện</th>
                    <th class="text-end">Nước cũ → mới</th>
                    <th class="text-end">Số dùng</th>
                    <th class="text-end">Tiền nước</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted py-4">Chưa có bản ghi điện nước nào.</td></tr>
                }
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.KyGhi</td>
                        <td><a asp-controller="Rooms" asp-action="Details" asp-route-id="@u.MaPhong">@u.Room?.MaPhongKyHieu</a></td>
                        <td class="text-end small">@u.ChiSoDienCu.ToString("N0") → @u.ChiSoDienMoi.ToString("N0")</td>
                        <td class="text-end">@u.SoDienSuDung.ToString("N0") kW</td>
                        <td class="text-end small">@u.DonGiaDien.ToString("N0")</td>
                        <td class="text-end fw-semibold">@u.TienDien.ToString("N0")</td>
                        <td class="text-end small">@u.ChiSoNuocCu.ToString("N0") → @u.ChiSoNuocMoi.ToString("N0")</td>
                        <td class="text-end">@u.SoNuocSuDung.ToString("N0") m³</td>
                        <td class="text-end fw-semibold">@u.TienNuoc.ToString("N0")</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@u.MaGhiChiSo" class="btn btn-outline-warning btn-sm-icon" title="Sửa"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@u.MaGhiChiSo" method="post" class="d-inline"
                                  data-confirm="Xóa bản ghi điện nước phòng @u.Room?.MaPhongKyHieu kỳ @u.KyGhi?">
                                <button type="submit" class="btn btn-outline-danger btn-sm-icon" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
