<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý nhà trọ</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="border-end bg-white sidebar" id="sidebar-wrapper">
            <div class="sidebar-heading text-center py-4 primary-text fs-5 fw-bold text-uppercase border-bottom">
                <i class="bi bi-house-door-fill me-2"></i>Quản lý nhà trọ
            </div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action p-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i>Tổng quan
                </a>
                <a class="list-group-item list-group-item-action p-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rooms" ? "active" : "")" asp-controller="Rooms" asp-action="Index">
                    <i class="bi bi-door-open me-2"></i>Phòng
                </a>
                <a class="list-group-item list-group-item-action p-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tenants" ? "active" : "")" asp-controller="Tenants" asp-action="Index">
                    <i class="bi bi-people me-2"></i>Người thuê
                </a>
                <a class="list-group-item list-group-item-action p-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Contracts" ? "active" : "")" asp-controller="Contracts" asp-action="Index">
                    <i class="bi bi-file-earmark-text me-2"></i>Hợp đồng
                </a>
                <a class="list-group-item list-group-item-action p-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Utilities" ? "active" : "")" asp-controller="Utilities" asp-action="Index">
                    <i class="bi bi-lightning-charge me-2"></i>Điện nước
                </a>
                <a class="list-group-item list-group-item-action p-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Services" ? "active" : "")" asp-controller="Services" asp-action="Index">
                    <i class="bi bi-wifi me-2"></i>Dịch vụ
                </a>
                <a class="list-group-item list-group-item-action p-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Invoices" ? "active" : "")" asp-controller="Invoices" asp-action="Index">
                    <i class="bi bi-receipt me-2"></i>Hóa đơn
                </a>
                <a class="list-group-item list-group-item-action p-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Payments" ? "active" : "")" asp-controller="Payments" asp-action="Index">
                    <i class="bi bi-cash-coin me-2"></i>Thanh toán
                </a>
                <a class="list-group-item list-group-item-action p-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MoveOut" ? "active" : "")" asp-controller="MoveOut" asp-action="Index">
                    <i class="bi bi-box-arrow-right me-2"></i>Trả phòng
                </a>
                <a class="list-group-item list-group-item-action p-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-bar-chart-line me-2"></i>Thống kê &amp; báo cáo
                </a>
            </div>
        </div>

        <!-- Page content -->
        <div id="page-content-wrapper" class="flex-grow-1">
            <!-- Header -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3 px-4">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary btn-sm me-3 d-none d-md-inline" id="sidebarToggle"><i class="bi bi-list"></i></button>
                    <span class="fw-semibold text-secondary">@ViewData["Title"]</span>
                </div>
                <div class="ms-auto d-flex align-items-center">
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@(User.Identity?.Name)
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-left me-2"></i>Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main content -->
            <main class="container-fluid px-4 py-4">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="text-center text-muted py-3 border-top">
                <small>&copy; @DateTime.Now.Year - Hệ thống quản lý nhà trọ</small>
            </footer>
        </div>
    </div>

    <!-- Confirm dialog dùng chung -->
    <div class="modal fade" id="confirmModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning-subtle">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận thao tác</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="confirmMessage"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger" id="confirmOkBtn">Đồng ý</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">
        @if (TempData["Success"] != null)
        {
            <div class="toast align-items-center text-bg-success border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast align-items-center text-bg-danger border-0 show" role="alert" data-bs-delay="8000">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-exclamation-octagon me-2"></i>@TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
