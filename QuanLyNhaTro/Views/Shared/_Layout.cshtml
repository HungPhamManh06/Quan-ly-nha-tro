@functions {
    bool Controller(string name) => ViewContext.RouteData.Values["Controller"]?.ToString() == name;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý nhà trọ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-house-heart-fill"></i></div>
            <div>
                <div class="brand-name">Quản lý nhà trọ</div>
                <div class="brand-sub">Bảng điều khiển chủ trọ</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">Tổng quan</div>
            <a class="nav-link-item @(Controller("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2"></i>Tổng quan
            </a>

            <div class="nav-section">Phòng &amp; người</div>
            <a class="nav-link-item @(Controller("Rooms") ? "active" : "")" asp-controller="Rooms" asp-action="Index">
                <i class="bi bi-door-open"></i>Phòng
            </a>
            <a class="nav-link-item @(Controller("Tenants") ? "active" : "")" asp-controller="Tenants" asp-action="Index">
                <i class="bi bi-people"></i>Người thuê
            </a>

            <div class="nav-section">Hợp đồng &amp; tài chính</div>
            <a class="nav-link-item @(Controller("Contracts") ? "active" : "")" asp-controller="Contracts" asp-action="Index">
                <i class="bi bi-file-earmark-text"></i>Hợp đồng
            </a>
            <a class="nav-link-item @(Controller("Utilities") ? "active" : "")" asp-controller="Utilities" asp-action="Index">
                <i class="bi bi-lightning-charge"></i>Điện nước
            </a>
            <a class="nav-link-item @(Controller("Services") ? "active" : "")" asp-controller="Services" asp-action="Index">
                <i class="bi bi-wifi"></i>Dịch vụ
            </a>
            <a class="nav-link-item @(Controller("Invoices") ? "active" : "")" asp-controller="Invoices" asp-action="Index">
                <i class="bi bi-receipt"></i>Hóa đơn
            </a>
            <a class="nav-link-item @(Controller("Payments") ? "active" : "")" asp-controller="Payments" asp-action="Index">
                <i class="bi bi-cash-coin"></i>Thanh toán
            </a>
            <a class="nav-link-item @(Controller("MoveOut") ? "active" : "")" asp-controller="MoveOut" asp-action="Index">
                <i class="bi bi-box-arrow-right"></i>Trả phòng
            </a>

            <div class="nav-section">Báo cáo</div>
            <a class="nav-link-item @(Controller("Reports") ? "active" : "")" asp-controller="Reports" asp-action="Index">
                <i class="bi bi-graph-up-arrow"></i>Thống kê &amp; báo cáo
            </a>
        </nav>

        <div class="sidebar-foot">
            Hệ thống quản lý một nhà trọ duy nhất — dành riêng cho Chủ trọ
        </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Khối nội dung -->
    <div class="app-main">
        <!-- Top header -->
        <header class="app-header">
            <button class="hamburger" id="sidebarToggle" aria-label="Mở/đóng menu" aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>
            <div class="header-title d-none d-sm-block">@ViewData["Title"]</div>

            <div class="ms-auto d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="user-chip" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">CT</span>
                        <span class="user-info">
                            <span class="user-name">@User.Identity?.Name</span>
                            <span class="user-role">Chủ trọ</span>
                        </span>
                        <i class="bi bi-chevron-down chev"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-box-arrow-left"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Nội dung trang -->
        <main class="app-content fade-in">
            @RenderBody()
        </main>

        <footer class="app-footer">
            &copy; @DateTime.Now.Year · Hệ thống quản lý nhà trọ · Dành cho Chủ trọ
        </footer>
    </div>

    <!-- Modal xác nhận dùng chung -->
    <div class="modal fade" id="confirmModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm-confirm" style="max-width:420px">
            <div class="modal-content">
                <div class="confirm-body">
                    <div class="confirm-icon" id="confirmIcon"><i class="bi bi-exclamation-triangle"></i></div>
                    <div class="confirm-title" id="confirmTitle">Xác nhận thao tác</div>
                    <div class="confirm-msg" id="confirmMessage"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger" id="confirmOkBtn">Đồng ý</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">
        @if (TempData["Success"] != null)
        {
            <div class="toast toast-modern toast-success" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-body">
                    <div class="toast-inner">
                        <span class="toast-ico"><i class="bi bi-check-lg"></i></span>
                        <div class="flex-grow-1">
                            <div class="toast-title">Thành công</div>
                            <div class="toast-msg">@TempData["Success"]</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Đóng"></button>
                    </div>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast toast-modern toast-error" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="8000">
                <div class="toast-body">
                    <div class="toast-inner">
                        <span class="toast-ico"><i class="bi bi-exclamation-lg"></i></span>
                        <div class="flex-grow-1">
                            <div class="toast-title">Lỗi</div>
                            <div class="toast-msg">@TempData["Error"]</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Đóng"></button>
                    </div>
                </div>
            </div>
        }
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
