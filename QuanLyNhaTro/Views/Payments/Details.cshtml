@model Payment
@{
    ViewData["Title"] = "Chi tiết thanh toán";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Danh sách thanh toán</a>

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <div class="brand-icon" style="width:52px;height:52px;border-radius:14px;font-size:1.3rem;background:linear-gradient(135deg,#15803D,#22C55E)"><i class="bi bi-cash-coin"></i></div>
        <div>
            <h1 class="page-title mb-0">Thanh toán #@Model.MaThanhToan</h1>
            <div class="mt-1">
                <span class="mini-tag">@Model.Invoice?.Room?.MaPhongKyHieu</span>
                <span class="mini-tag ms-1">Kỳ @Model.Invoice?.KyHoaDon</span>
                <span class="mini-tag ms-1">@Model.PhuongThuc.GetDisplayName()</span>
            </div>
        </div>
    </div>
</div>

<div class="card" style="max-width:640px">
    <div class="card-body">
        <dl>
            <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Hóa đơn</dt><dd><a class="cell-code" asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.MaHoaDon">@Model.Invoice?.MaHoaDonKyHieu</a></dd></div>
            <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Phòng</dt><dd>@Model.Invoice?.Room?.MaPhongKyHieu</dd></div>
            <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Kỳ</dt><dd>@Model.Invoice?.KyHoaDon</dd></div>
            <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Tổng tiền hóa đơn</dt><dd class="money">@Model.Invoice?.TongTien.ToString("N0") đ</dd></div>
            <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Số tiền ghi nhận</dt><dd class="money fw-bold text-success fs-5">@Model.SoTien.ToString("N0") đ</dd></div>
            <div class="d-flex justify-content-between border-bottom py-1"><dt class="text-muted fw-normal small">Ngày thanh toán</dt><dd class="num">@Model.NgayThanhToan.ToString("dd/MM/yyyy HH:mm")</dd></div>
            <div class="d-flex justify-content-between py-1"><dt class="text-muted fw-normal small">Ghi chú</dt><dd class="text-end">@(Model.GhiChu ?? "—")</dd></div>
        </dl>
    </div>
</div>
