@model List<Payment>
@{
    ViewData["Title"] = "Thanh toán";
}

<h3 class="fw-bold mb-4"><i class="bi bi-cash-coin me-2 text-success"></i>Danh sách thanh toán</h3>

<div class="card chart-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Mã TT</th>
                    <th>Hóa đơn</th>
                    <th>Phòng</th>
                    <th>Kỳ</th>
                    <th class="text-end">Số tiền</th>
                    <th>Ngày thanh toán</th>
                    <th>Phương thức</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Chưa có thanh toán nào.</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">#@p.MaThanhToan</td>
                        <td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@p.MaHoaDon">@p.Invoice?.MaHoaDonKyHieu</a></td>
                        <td>@p.Invoice?.Room?.MaPhongKyHieu</td>
                        <td>@p.Invoice?.KyHoaDon</td>
                        <td class="text-end fw-semibold">@p.SoTien.ToString("N0") đ</td>
                        <td>@p.NgayThanhToan.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@p.PhuongThuc.GetDisplayName()</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@p.MaThanhToan" class="btn btn-outline-info btn-sm-icon" title="Chi tiết"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
