@model PaymentViewModel
@{
    ViewData["Title"] = "Thanh toán hóa đơn";
}

<a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.MaHoaDon" class="back-link"><i class="bi bi-arrow-left"></i>Chi tiết hóa đơn</a>

<div class="page-header">
    <div>
        <h1 class="page-title">Thanh toán hóa đơn</h1>
        <p class="page-subtitle">@Model.MaHoaDonKyHieu · Phòng @Model.TenPhong · Kỳ @Model.KyHoaDon</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center">
                <span>Thông tin hóa đơn</span>
                <span class="ms-auto money fw-bold text-danger fs-5">@Model.TongTien.ToString("N0") đ</span>
            </div>
            <div class="card-body">
                <form asp-action="Pay" method="post" id="payForm" data-confirm="Xác nhận ghi nhận thanh toán hóa đơn @Model.MaHoaDonKyHieu? Mỗi hóa đơn chỉ được thanh toán một lần duy nhất." data-confirm-title="Xác nhận thanh toán?">
                    <input type="hidden" asp-for="MaHoaDon" />
                    <input type="hidden" asp-for="MaHoaDonKyHieu" />
                    <input type="hidden" asp-for="TenPhong" />
                    <input type="hidden" asp-for="KyHoaDon" />
                    <input type="hidden" asp-for="TongTien" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="SoTien" class="form-label">Số tiền khách trả (đ)</label>
                            <input asp-for="SoTien" class="form-control money" type="number" min="0" id="soTienInput" />
                            <span asp-validation-for="SoTien" class="text-danger small"></span>
                            <div class="form-text" id="soTienHint"></div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhuongThuc" class="form-label"></label>
                            <select asp-for="PhuongThuc" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NgayThanhToan" class="form-label"></label>
                            <input asp-for="NgayThanhToan" class="form-control" type="date" />
                        </div>
                        <div class="col-12">
                            <label asp-for="GhiChu" class="form-label"></label>
                            <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2 pt-3 mt-2 border-top">
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Ghi nhận thanh toán</button>
                        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.MaHoaDon" class="btn btn-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-info-circle me-2"></i>Quy tắc thanh toán</div>
            <div class="card-body">
                <div class="attention-item px-0">
                    <span class="attention-icon danger"><i class="bi bi-x-lg"></i></span>
                    <div class="attention-main">
                        <div class="attention-title">Trả thiếu</div>
                        <div class="attention-desc">Không chấp nhận, không tạo thanh toán — hóa đơn vẫn <span class="badge badge-chuathanhtoan">Chưa thanh toán</span></div>
                    </div>
                </div>
                <div class="attention-item px-0">
                    <span class="attention-icon" style="background:var(--color-success-soft);color:var(--color-success)"><i class="bi bi-check-lg"></i></span>
                    <div class="attention-main">
                        <div class="attention-title">Trả đủ</div>
                        <div class="attention-desc">Tạo thanh toán — hóa đơn chuyển <span class="badge badge-dathanhtoan">Đã thanh toán</span></div>
                    </div>
                </div>
                <div class="attention-item px-0">
                    <span class="attention-icon warning"><i class="bi bi-arrow-return-left"></i></span>
                    <div class="attention-main">
                        <div class="attention-title">Trả thừa</div>
                        <div class="attention-desc">Ghi nhận đúng tổng tiền hóa đơn, phần thừa hoàn lại cho khách</div>
                    </div>
                </div>
                <div class="small td-muted mt-2"><i class="bi bi-shield-check me-1"></i>Mỗi hóa đơn chỉ được thanh toán <b>một lần duy nhất</b>.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const tongTien = @Model.TongTien;
        const input = document.getElementById('soTienInput');
        const hint = document.getElementById('soTienHint');
        const fmt = n => new Intl.NumberFormat('vi-VN').format(n) + ' đ';
        function updateHint() {
            const v = parseFloat(input?.value || 0);
            if (!hint) return;
            if (v > 0 && v < tongTien) {
                hint.className = 'form-text text-danger';
                hint.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Chưa đủ! Còn thiếu <b>' + fmt(tongTien - v) + '</b> — hệ thống sẽ KHÔNG chấp nhận.';
            } else if (v > tongTien) {
                hint.className = 'form-text text-info';
                hint.innerHTML = '<i class="bi bi-info-circle me-1"></i>Trả thừa <b>' + fmt(v - tongTien) + '</b> — phần thừa hoàn lại, chỉ ghi nhận ' + fmt(tongTien) + '.';
            } else if (v === tongTien) {
                hint.className = 'form-text text-success';
                hint.innerHTML = '<i class="bi bi-check-circle me-1"></i>Đủ tiền, có thể ghi nhận thanh toán.';
            } else {
                hint.className = 'form-text text-muted';
                hint.textContent = 'Nhập số tiền khách đưa.';
            }
        }
        input?.addEventListener('input', updateHint);
        updateHint();
    </script>
}
