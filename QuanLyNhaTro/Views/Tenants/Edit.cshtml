@model Tenant
@{
    ViewData["Title"] = "Sửa người thuê";
}

<h3 class="fw-bold mb-4"><i class="bi bi-pencil-square me-2 text-warning"></i>Sửa người thuê: @Model.HoTen</h3>

<div class="card chart-card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MaNguoiThue" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label"></label>
                    <input asp-for="HoTen" class="form-control" />
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CCCD" class="form-label"></label>
                    <input asp-for="CCCD" class="form-control" maxlength="12" />
                    <span asp-validation-for="CCCD" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label"></label>
                    <input asp-for="SoDienThoai" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="QueQuan" class="form-label"></label>
                    <input asp-for="QueQuan" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Trạng thái (tự động theo hợp đồng)</label>
                    <input class="form-control" value="@Model.TrangThai" disabled />
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label"></label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
