@model List<TenantListItem>
@{
    ViewData["Title"] = "Quản lý người thuê";
    string Initial(string hoTen) => string.IsNullOrWhiteSpace(hoTen) ? "?" : hoTen.Trim().Split(' ')[^1][..1].ToUpper();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý người thuê</h1>
        <p class="page-subtitle">Thông tin và phòng hiện tại của người thuê</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Thêm người thuê</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body toolbar py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:#94A3B8"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="padding-left:34px" placeholder="Tìm theo họ tên / CCCD / số điện thoại…" />
                </div>
            </div>
            <div class="col-md-3 col-lg-2">
                <button class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Tìm kiếm</button>
            </div>
            <div class="col-md-3 col-lg-2">
                <a asp-action="Index" class="btn btn-secondary w-100">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-people"></i></div>
            <div class="empty-title">Chưa có người thuê nào</div>
            <p class="empty-desc">Thêm người thuê đầu tiên để bắt đầu lập hợp đồng.</p>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Thêm người thuê</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Người thuê</th>
                        <th class="d-none d-md-table-cell">CCCD</th>
                        <th class="d-none d-lg-table-cell">SĐT</th>
                        <th>Phòng hiện tại</th>
                        <th class="d-none d-md-table-cell">Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar" style="width:34px;height:34px;font-size:.75rem">@Initial(item.Tenant.HoTen)</span>
                                    <div>
                                        <div class="fw-semibold">@item.Tenant.HoTen</div>
                                        <div class="small td-muted">#@item.Tenant.MaNguoiThue</div>
                                    </div>
                                </div>
                            </td>
                            <td class="d-none d-md-table-cell num">@item.Tenant.CCCD</td>
                            <td class="d-none d-lg-table-cell num">@(item.Tenant.SoDienThoai ?? "—")</td>
                            <td>
                                @if (item.MaPhongHienTai != null)
                                {
                                    <a class="cell-code" asp-controller="Rooms" asp-action="Details" asp-route-id="@item.MaPhongHienTai">@item.PhongHienTai</a>
                                }
                                else
                                {
                                    <span class="td-muted">—</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">
                                <span class="badge @(item.Tenant.TrangThai == "Đang thuê" ? "badge-hieuluc" : "badge-dathanhly")">@item.Tenant.TrangThai</span>
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn-dots" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Thao tác"><i class="bi bi-three-dots-vertical"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Tenant.MaNguoiThue"><i class="bi bi-eye"></i>Xem chi tiết</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Tenant.MaNguoiThue"><i class="bi bi-pencil"></i>Chỉnh sửa</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@item.Tenant.MaNguoiThue" method="post" data-confirm="Người thuê @item.Tenant.HoTen sẽ bị xóa. Nếu đã phát sinh lịch sử nghiệp vụ, hệ thống sẽ không cho phép xóa." data-confirm-danger="true" data-confirm-title="Xóa người thuê?">
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash"></i>Xóa</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
