@model List<TenantListItem>
@{
    ViewData["Title"] = "Quản lý người thuê";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Quản lý người thuê</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Thêm người thuê</a>
</div>

<div class="card chart-card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small text-muted">Tìm kiếm theo họ tên / CCCD / số điện thoại</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="VD: Nguyễn Văn A hoặc 012345678901" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Tìm kiếm</button>
            </div>
            <div class="col-md-3">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card chart-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Họ tên</th>
                    <th>CCCD</th>
                    <th>SĐT</th>
                    <th>Phòng hiện tại</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Chưa có người thuê nào.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">#@item.Tenant.MaNguoiThue</td>
                        <td>@item.Tenant.HoTen</td>
                        <td>@item.Tenant.CCCD</td>
                        <td>@item.Tenant.SoDienThoai</td>
                        <td>
                            @if (item.MaPhongHienTai != null)
                            {
                                <a asp-controller="Rooms" asp-action="Details" asp-route-id="@item.MaPhongHienTai">@item.PhongHienTai</a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td><span class="badge @(item.Tenant.TrangThai == "Đang thuê" ? "badge-hieuluc" : "badge-dathanhly")">@item.Tenant.TrangThai</span></td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Tenant.MaNguoiThue" class="btn btn-outline-info btn-sm-icon" title="Xem"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Tenant.MaNguoiThue" class="btn btn-outline-warning btn-sm-icon" title="Sửa"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Tenant.MaNguoiThue" method="post" class="d-inline"
                                  data-confirm="Bạn có chắc muốn xóa người thuê @item.Tenant.HoTen? (Người thuê đã phát sinh lịch sử sẽ không thể xóa)">
                                <button type="submit" class="btn btn-outline-danger btn-sm-icon" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
