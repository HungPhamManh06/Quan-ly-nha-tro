@model ServiceUsage
@{
    ViewData["Title"] = "Ghi sử dụng dịch vụ";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Quản lý dịch vụ</a>

<div class="page-header">
    <div>
        <h1 class="page-title">Ghi sử dụng dịch vụ</h1>
        <p class="page-subtitle">Ghi nhận dịch vụ phòng sử dụng trong kỳ — giá được cố định vào bản ghi</p>
    </div>
</div>

<div class="card" style="max-width:960px">
    <div class="card-body p-4">
        <form asp-action="CreateUsage" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MaPhong" class="form-label"></label>
                    <select asp-for="MaPhong" class="form-select" asp-items="ViewBag.Rooms">
                        <option value="">-- Chọn phòng --</option>
                    </select>
                    <span asp-validation-for="MaPhong" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaDichVu" class="form-label"></label>
                    <select asp-for="MaDichVu" class="form-select" asp-items="ViewBag.DichVus">
                        <option value="">-- Chọn dịch vụ --</option>
                    </select>
                    <span asp-validation-for="MaDichVu" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="KySuDung" class="form-label"></label>
                    <input asp-for="KySuDung" class="form-control" type="month" />
                    <span asp-validation-for="KySuDung" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SoLuong" class="form-label"></label>
                    <input asp-for="SoLuong" class="form-control" type="number" step="0.01" min="0.01" placeholder="1" />
                    <span asp-validation-for="SoLuong" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DonGiaApDung" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="DonGiaApDung" class="form-control" type="number" min="0" />
                        <span class="input-group-text">đ</span>
                    </div>
                    <div class="form-text">Mặc định lấy đơn giá hiện tại, có thể sửa — giá được cố định vào bản ghi.</div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="border rounded-3 p-3 w-100 text-center" style="border-color:var(--color-border) !important;background:var(--color-primary-soft)">
                        <div class="kpi-label">Thành tiền</div>
                        <div class="fw-bold text-primary fs-5 money" id="thanhTienPreview">0 đ</div>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label"></label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2" placeholder="Ghi chú (không bắt buộc)"></textarea>
                </div>
            </div>

            <div class="alert alert-info small d-flex gap-2 align-items-start mt-3 mb-4">
                <i class="bi bi-info-circle mt-1"></i>
                <div>Mỗi phòng + dịch vụ + kỳ chỉ được ghi một bản ghi. Thành tiền = Số lượng × Đơn giá áp dụng.</div>
            </div>

            <div class="d-flex gap-2 pt-3 border-top">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function recalc() {
            const sl = parseFloat(document.getElementById('SoLuong')?.value || 0);
            const dg = parseFloat(document.getElementById('DonGiaApDung')?.value || 0);
            const el = document.getElementById('thanhTienPreview');
            if (el) el.textContent = new Intl.NumberFormat('vi-VN').format(sl * dg) + ' đ';
        }
        ['SoLuong', 'DonGiaApDung'].forEach(function (id) {
            document.getElementById(id)?.addEventListener('input', recalc);
        });
        recalc();
    </script>
}
