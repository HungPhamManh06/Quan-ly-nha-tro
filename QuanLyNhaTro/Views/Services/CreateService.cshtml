@model Service
@{
    ViewData["Title"] = "Thêm dịch vụ";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Quản lý dịch vụ</a>

<div class="page-header">
    <div>
        <h1 class="page-title">Thêm dịch vụ</h1>
        <p class="page-subtitle">Định nghĩa dịch vụ thu thêm: internet, gửi xe, vệ sinh…</p>
    </div>
</div>

<div class="card" style="max-width:880px">
    <div class="card-body p-4">
        <form asp-action="CreateService" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TenDichVu" class="form-label"></label>
                    <input asp-for="TenDichVu" class="form-control" placeholder="VD: Internet, Gửi xe, Vệ sinh…" />
                    <span asp-validation-for="TenDichVu" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DonViTinh" class="form-label"></label>
                    <input asp-for="DonViTinh" class="form-control" placeholder="VD: tháng, chiếc, người" />
                    <span asp-validation-for="DonViTinh" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DonGia" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="DonGia" class="form-control" type="number" min="0" placeholder="50000" />
                        <span class="input-group-text">đ</span>
                    </div>
                    <span asp-validation-for="DonGia" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Trạng thái</label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="true">Hoạt động</option>
                        <option value="false">Ngừng hoạt động</option>
                    </select>
                </div>
            </div>
            <div class="d-flex gap-2 pt-3 mt-3 border-top">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu dịch vụ</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
