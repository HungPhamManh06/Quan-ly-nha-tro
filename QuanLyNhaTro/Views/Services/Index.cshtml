@{
    ViewData["Title"] = "Quản lý dịch vụ";
    var services = (List<Service>)ViewBag.Services;
    var usages = (List<ServiceUsage>)ViewBag.Usages;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="fw-bold mb-0"><i class="bi bi-wifi me-2 text-info"></i>Quản lý dịch vụ</h3>
    <div>
        <a asp-action="CreateService" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm dịch vụ</a>
        <a asp-action="CreateUsage" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Ghi sử dụng dịch vụ</a>
    </div>
</div>

<div class="card chart-card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Tìm dịch vụ</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="VD: Internet" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted">Kỳ sử dụng (yyyy-MM)</label>
                <input type="month" name="ky" value="@ViewBag.Ky" class="form-control" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Tìm</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách dịch vụ -->
<div class="card chart-card mb-3">
    <div class="card-header bg-transparent fw-semibold"><i class="bi bi-list-ul me-2"></i>Danh sách dịch vụ</div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Tên dịch vụ</th>
                    <th>Đơn vị tính</th>
                    <th class="text-end">Đơn giá</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in services)
                {
                    <tr>
                        <td class="fw-semibold">@s.TenDichVu</td>
                        <td>@s.DonViTinh</td>
                        <td class="text-end">@s.DonGia.ToString("N0") đ</td>
                        <td><span class="badge @(s.TrangThai ? "badge-hieuluc" : "badge-dathanhly")">@(s.TrangThai ? "Hoạt động" : "Ngưng")</span></td>
                        <td class="text-center">
                            <a asp-action="EditService" asp-route-id="@s.MaDichVu" class="btn btn-outline-warning btn-sm-icon" title="Sửa"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DeleteService" asp-route-id="@s.MaDichVu" method="post" class="d-inline"
                                  data-confirm="Xóa dịch vụ @s.TenDichVu? (Dịch vụ đã phát sinh lịch sử sẽ bị ngưng hoạt động thay vì xóa)">
                                <button type="submit" class="btn btn-outline-danger btn-sm-icon" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!services.Any()) { <tr><td colspan="5" class="text-muted text-center py-3">Chưa có dịch vụ.</td></tr> }
            </tbody>
        </table>
    </div>
</div>

<!-- Sử dụng dịch vụ theo kỳ -->
<div class="card chart-card">
    <div class="card-header bg-transparent fw-semibold d-flex">
        <span><i class="bi bi-clipboard-check me-2"></i>Sử dụng dịch vụ kỳ <span class="text-primary">@ViewBag.Ky</span></span>
        <span class="ms-auto fw-normal">Tổng: @usages.Sum(su => su.ThanhTien).ToString("N0") đ</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Phòng</th>
                    <th>Dịch vụ</th>
                    <th>Kỳ</th>
                    <th class="text-end">Số lượng</th>
                    <th class="text-end">Đơn giá áp dụng</th>
                    <th class="text-end">Thành tiền</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var su in usages)
                {
                    <tr>
                        <td><a asp-controller="Rooms" asp-action="Details" asp-route-id="@su.Room?.MaPhong">@su.Room?.MaPhongKyHieu</a></td>
                        <td>@su.Service?.TenDichVu</td>
                        <td>@su.KySuDung</td>
                        <td class="text-end">@su.SoLuong.ToString("N0") @su.Service?.DonViTinh</td>
                        <td class="text-end">@su.DonGiaApDung.ToString("N0")</td>
                        <td class="text-end fw-semibold">@su.ThanhTien.ToString("N0")</td>
                        <td class="text-center">
                            <a asp-action="EditUsage" asp-route-id="@su.MaSuDung" class="btn btn-outline-warning btn-sm-icon" title="Sửa"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DeleteUsage" asp-route-id="@su.MaSuDung" method="post" class="d-inline"
                                  data-confirm="Xóa bản ghi sử dụng dịch vụ @su.Service?.TenDichVu phòng @su.Room?.MaPhongKyHieu?">
                                <button type="submit" class="btn btn-outline-danger btn-sm-icon" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!usages.Any()) { <tr><td colspan="7" class="text-muted text-center py-3">Chưa có bản ghi sử dụng trong kỳ này.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
