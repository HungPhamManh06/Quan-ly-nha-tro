{
  // Database:Provider = sqlserver (mặc định, đúng đặc tả) | sqlite (chỉ để demo/preview không cần SQL Server)
  "Database:Provider": "sqlserver",
  "ConnectionStrings": {
    // Chọn đúng instance SQL Server đang cài trên máy:
    //   Server=.                      → bản mặc định
    //   Server=.\SQLEXPRESS           → bản SQL Server Express
    //   Server=(localdb)\MSSQLLocalDB → LocalDB
    // Nếu dùng tài khoản SQL (sa) thay vì tài khoản Windows, thay Trusted_Connection=True
    // bằng: User Id=sa;Password=matkhau_cua_ban;
    "DefaultConnection": "Server=.;Database=QuanLyNhaTroDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "DemoSqlite": "Data Source=QuanLyNhaTroDemo.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
